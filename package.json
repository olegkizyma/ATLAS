{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS stack monorepo with unified dependencies",
  "type": "module",
  "workspaces": [
    "frontend_new/orchestrator",
    "client-module/nodejs_client",
    "client-module/proxy_server"
  ],
  "scripts": {
    "start:proxy": "npm --workspace client-module/proxy_server start",
    "dev:proxy": "npm --workspace client-module/proxy_server run dev",
    "start:orch": "npm --workspace frontend_new/orchestrator start",
    "postinstall": "echo 'Root postinstall complete'"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "better-sqlite3": "^9.4.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "openai": "^5.20.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.15.1"
  },
  "overrides": {
    "openai": "^5.20.0"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
