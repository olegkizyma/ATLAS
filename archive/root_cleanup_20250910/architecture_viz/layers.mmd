%% Layered architecture view - Updated with Recovery Bridge (September 7, 2025)
flowchart TB
    subgraph Presentation[Presentation Layer]
        UI[Web UI / Chat]
    end

    subgraph API[API Layer]
        Flask[Flask Server 5001]
    end

    subgraph Orchestrator[Orchestration Layer]
        Node[Node Orchestrator 5101]
        Metrics[Prometheus Export]
    end

    subgraph Recovery[Recovery & Reliability Layer ✅]
        RB[Recovery Bridge WS:5102]
        RBHealth[Health Monitor :5103]
        IRS[Intelligent Recovery System]
        FHandler[Failure Handler]
    end

    subgraph Agents[Agent Layer]
        Atlas[Atlas Planner]
        Grisha[Grisha Validator]
        Tetyana[Tetyana Executor]
    end

    subgraph Intelligence[Intelligence Support]
        Memory[(SQLite Memory)]
        Ranking[Ranked Summarizer]
        Dedup[rememberSafe Dedup]
        Pruning[TTL & Capacity Pruning]
    end

    subgraph External[External / Optional]
        Goose[Goose Executor 3000]
        TTS[TTS 3001]
        LLM[Local AI API 3010]
        Vision[Grisha Vision]
    end

