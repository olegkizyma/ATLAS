%% High-level multi-agent system overview with Recovery Bridge, timing, ACK mode, and duplicate handling
%% Updated: September 7, 2025 - Recovery Bridge integration added
flowchart TD
    subgraph Client[User / UI]
        UI[Web UI / Chat]
    end

    UI -->|sync or ACK mode| API[Flask API 5001]
    API -->|clientMessageId + timing| Orchestrator[Node Orchestrator 5101]

    subgraph Agents[Multi-Agent Core]
        Atlas[Atlas\nPlanner\n+per-agent timing]
        Grisha[Grisha\nValidator\n+per-agent timing]
        Tetyana[Tetyana\nExecutor\n+per-agent timing]
    end

    subgraph RecoverySystem[Recovery Bridge System - ACTIVE ✅]
        RB[Recovery Bridge\nWebSocket :5102\nHealth :5103]
        IRS[Intelligent Recovery\nFailure Analysis]
        RBComm[JS Integration\nAdaptation Engine]
        RBHealth[Health Monitoring\n/health endpoint]
    end

    Orchestrator <-->|failure recovery| RB
    RB --> IRS --> RBComm
    RB --> RBHealth
    IRS -->|adaptation parameters| Orchestrator

    subgraph ACKFlow[ACK Mode Flow]
        ACKReq[ACK Request\nX-Atlas-Ack: immediate]
        ACKResp[Immediate Accept\n~3s timeout]
        StatusPoll[Status Polling\n/api/chat/status/<id>]
        StatusCheck[Session Status Check\n/session/<id>/status]
    end

    UI -->|ackMode=true| ACKReq
    ACKReq --> ACKResp --> UI
    UI -->|poll every 2s| StatusPoll
    StatusPoll --> StatusCheck --> UI

    subgraph DuplicateSuppress[Duplicate Suppression - NEW]
        Cache[(clientMessageId Cache\nTTL 5min)]
        Suppress[Suppress Duplicate]
        Metric[duplicates_suppressed_total\nPrometheus metric]
    end

    Orchestrator --> Cache
    Cache -->|duplicate found| Suppress --> Metric

    subgraph TimingMetrics[Timing System - NEW]
        AgentTiming[Per-Agent Timing\nagentMs, provider, model]
        CycleTiming[Cycle Duration\ntotalMs in response]
        RouteMetrics[Route Success/Fail\nms per route attempt]
    end

    Orchestrator --> Atlas
    Atlas -->|+timing logs| Grisha
    Grisha -->|approve/adjust +timing| Tetyana
    Tetyana -->|execution result +timing| Grisha
    Grisha -->|verdict & followup +timing| Orchestrator
    Orchestrator -->|response + timing| API --> UI

    Atlas --> AgentTiming
    Grisha --> AgentTiming  
    Tetyana --> AgentTiming
    Orchestrator --> CycleTiming
    Orchestrator --> RouteMetrics

    subgraph ProbeCycle[Probe Cycle - ENHANCED]
        TP[Tetyana Probe\n+execution timing]
        GP[Grisha Probe Review\n+review timing]
        AF[Atlas Feasibility\n+decision timing]
        ProbeAdvanced[PIPELINE_METRICS\nprobesAdvanced]
        ProbeClarified[PIPELINE_METRICS\nprobesClarified]
    end

    Atlas -. shortage detected .-> TP
    TP --> GP --> AF
    AF -->|ADVANCE| ProbeAdvanced --> Atlas
    AF -->|CLARIFY| ProbeClarified --> Atlas

    subgraph UnifiedLogging[Unified Logging - NEW]
        UTCFormat[UTC+Offset Format\n2025-09-07T02:30:15.123+02:00]
        NodeLogs[Node.js Orchestrator\nUTC+offset]
        PythonLogs[Python Frontend\nUTC+offset]
    end

    Atlas --> NodeLogs --> UTCFormat
    API --> PythonLogs --> UTCFormat

    subgraph MetricsExport[Enhanced Metrics]
        Prometheus[/metrics/prometheus]
        DuplicateMetric[atlas_duplicates_suppressed_total]
        TimingMetric[atlas_agent_timing_ms]
        ProbeMetrics[atlas_probe_* metrics]
    end

    Metric --> DuplicateMetric
    AgentTiming --> TimingMetric
    ProbeAdvanced --> ProbeMetrics
    ProbeClarified --> ProbeMetrics

    Prometheus --> DuplicateMetric
    Prometheus --> TimingMetric
    Prometheus --> ProbeMetrics

    subgraph Memory[Shared Memory (SQLite)]
        MAtlas[(Atlas Memory)]
        MGrisha[(Grisha Memory)]
        Prune[[TTL & Capacity Prune]]
        Sem[(Semantic (opt))]
    end

    Atlas <--> MAtlas
    Grisha <--> MGrisha
    MAtlas <-. shared context .-> MGrisha
    MAtlas --> Prune
    MGrisha --> Prune
    MAtlas -. embeddings .-> Sem
    MGrisha -. embeddings .-> Sem

    subgraph Metrics[Prometheus Metrics]
        P1[pipeline_phase_*]
        P2[probe_*]
        P3[memory_context_tokens]
        P4[agent_timing_ms]
        P5[duplicates_suppressed_total]
        P6[request_duration_ms]
    end
        P4[memory_context_injections]
        P5[memory_facts_written]
        P6[memory_facts_pruned]
        P7[semantic_enabled]
    end

    Orchestrator --> Metrics

    subgraph External[Optional Services]
        G[Goose Executor 3000]
        TTS[Ukrainian TTS 3001]
        LLM[Local AI API 3010]
    end

    Tetyana -->|task exec| G
    Orchestrator -->|LLM calls| LLM
    Orchestrator -->|voice gating| TTS
